# Deplot — copy to .env

GEMINI_API_KEY=
GITHUB_TOKEN=

# Zerops REST API: https://api.app-prg1.zerops.io/api/rest/public
# Token: Zerops GUI → Settings → Access Token Management → Generate new token
ZEROPS_API_TOKEN=

# Deplot platform project (hosts web, api, postgres, cache)
ZEROPS_PROJECT_ID=

# Separate project for wizard deploy testing — run: .\scripts\setup-deploy-sandbox.ps1
ZEROPS_DEPLOY_PROJECT_ID=

DATABASE_URL=postgresql+asyncpg://deplot:deplot@localhost:5432/deplot
REDIS_URL=redis://localhost:6379/0

DEBUG=true
DEMO_MODE_ENABLED=true
AI_AGENTS_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
